<UserControl x:Class="PokeMate.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="MateHost" Grid.Row="0" Style="{StaticResource PmCard}" Padding="12" Margin="0,0,0,10"/>
    <Border x:Name="HeaderHost" Grid.Row="1" Style="{StaticResource PmCard}" Padding="12" Margin="0,0,0,10"/>
    <!-- 대화 자리 (맥 HomeView 의 ChatView). [HomeChat] 이 붙은 화면이 들어온다 -->
    <Border Grid.Row="2" CornerRadius="14" ClipToBounds="True" Margin="0,0,0,4">
      <Grid>
        <Border Background="{DynamicResource FieldBg}" Opacity="0.75"/>
        <Border x:Name="ChatHost"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
