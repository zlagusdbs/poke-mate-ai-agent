<Window x:Class="PokeMate.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PokeMate" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" MinWidth="380" MinHeight="520" ShowActivated="True"
        Background="{DynamicResource WindowBg}" TextElement.Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 위쪽 탭 (맥 segmented Picker) -->
      <Border Grid.Row="0" Margin="14,14,14,10" Background="Transparent" MouseLeftButtonDown="DragArea">
        <Border Style="{StaticResource PmCard}" Padding="2" CornerRadius="9">
          <UniformGrid x:Name="TabBar" Rows="1"/>
        </Border>
      </Border>

      <!-- 탭 내용. 탭마다 만든 화면을 번갈아 끼운다 -->
      <Border x:Name="Host" Grid.Row="1"/>

      <!-- 아래 막대 (맥 FooterBar) -->
      <Grid x:Name="Footer" Grid.Row="2" Margin="16,6,16,10" Background="Transparent" MouseLeftButtonDown="DragArea">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="토큰 다시 계산" Click="OnRefresh"/>
          <TextBlock x:Name="UpdatedText" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource TextTertiary}"/>
        </StackPanel>
        <StackPanel x:Name="Tools" Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="OnPin"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
